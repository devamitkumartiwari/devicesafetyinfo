{
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Integrity": {
    "PackageName": "com.devamitkumartiwari.device_safety_info_example",
    "ServiceAccountJsonPath": "service-account.json",
    "AllowedCertificateSha256Digests": [],
    "RequiredDeviceVerdict": "MEETS_DEVICE_INTEGRITY",
    "TokenMaxAgeSeconds": 120,
    "RequireLicensed": false,
    "RejectedPlayProtectVerdicts": [],
    "RejectedAppAccessRisks": [],
    "MaxDeviceActivityLevel": "",

    "AppleTeamId": "YOUR_TEAM_ID",
    "BundleId": "com.devamitkumartiwari.deviceSafetyInfoExample",
    "AppleEnvironment": "development",
    "AppAttestRootCaPath": "AppleAppAttestRootCA.pem",
    "DeviceCheckKeyId": "YOUR_P8_KEY_ID",
    "DeviceCheckPrivateKeyPath": "AuthKey_DeviceCheck.p8"
  }
}
