<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntegrityServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Play Integrity decodeIntegrityToken client + Google service-account auth. -->
    <PackageReference Include="Google.Apis.PlayIntegrity.v1" Version="1.*" />
    <!-- App Attest attestation / assertion objects are CBOR. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AppleAppAttestRootCA.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
